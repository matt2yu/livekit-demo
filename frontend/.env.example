# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# Supabase — read-only, browser-safe. RLS restricts anon to SELECT on orders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe — test mode. All server-only: no NEXT_PUBLIC_ prefix on any of these.
# Checkout is the redirect flow, so no publishable key is needed in the bundle.
STRIPE_SECRET_KEY=
# Printed by: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Same value as agent/.env.local. deposit_paid is written only by the verified
# webhook, and RLS grants anon SELECT only, so that write needs the service role.
SUPABASE_SERVICE_ROLE_KEY=
